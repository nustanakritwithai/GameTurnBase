{
  "name": "legend-of-soul-th",
  "private": true,
  "version": "0.12.3",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:images && tsc -b && vite build",
    "build:models": "node tools/build-models.mjs",
    "build:images": "node tools/optimize-images.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "audit": "npm audit --audit-level=high",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build && node tools/check-bundle-size.mjs",
    "preview": "vite preview",
    "prepare": "husky",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.112.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "web-vitals": "^6.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "oxlint"
    ],
    "*.{json,css,md}": "prettier --write"
  },
  "license": "MIT"
}
